# Bez DATABASE_URL aplikacja używa lokalnego Postgresa w procesie (PGlite) zapisanego w ./.data/pglite
# Produkcja (Neon / Supabase / własny Postgres):
# DATABASE_URL=postgres://user:haslo@host:5432/ludos?sslmode=require

# WYMAGANE: hasło administratora (minimum 16 znaków). Bez niego panel pozostaje zablokowany.
# Ustaw własną, długą i losową wartość; nie commituj pliku .env.
ADMIN_PASSWORD=V7#mQ2!zR9@kL4$p

# Opcjonalnie: dodatkowy token wymagany przy wgrywaniu plików po zalogowaniu
# UPLOAD_TOKEN=tu-wstaw-drugi-losowy-token

# Opcjonalnie: nazwa gildii pokazywanej na stronie głównej (domyślnie: gildia z największą liczbą postaci)
# GUILD_NAME=Krwawy Topór
